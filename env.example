# Clave secreta para sesiones Flask (¡cambiar en producción!)
SECRET_KEY=cambia-esta-clave-por-una-muy-segura

# Entorno (development | production)
FLASK_ENV=development

# Puerto del servidor
PORT=5000

# Ruta de la base de datos SQLite (relativa al proyecto)
DATABASE_URL=sqlite:///instance/ferreteria.db

# Carpeta de uploads
UPLOAD_FOLDER=uploads

# Tamaño máximo de subida (en MB)
MAX_CONTENT_LENGTH_MB=16
